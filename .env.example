# Postgres (compose). takeoff가 5432를 쓰므로 5433.
POSTGRES_DB=kidscafe
POSTGRES_USER=kidscafe
POSTGRES_PASSWORD=kidscafe
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://kidscafe:kidscafe@localhost:5433/kidscafe

# 공공데이터포털(data.go.kr) 인증키. 활용신청(자동승인) 후 발급.
DATA_GO_KR_KEY=
# 조회서비스 엔드포인트 (2026-09-19 확인). 오퍼레이션 경로까지 포함해야 한다.
DATAGOKR_THEMEPARK_URL=https://apis.data.go.kr/1741000/amusement_facilities_other/info
DATAGOKR_RESTCAFE_URL=https://apis.data.go.kr/1741000/rest_cafes/info
DATAGOKR_PLAYGROUND_URL=https://apis.data.go.kr/1741000/pfc3/getPfctInfo3

# 경기데이터드림 인증키 (경기도_휴게음식점(키즈카페) 현황)
GG_DATA_KEY=
# VWorld 인증키 (지오코딩·좌표계 검증). vworld.kr → 오픈API → 인증키 발급
VWORLD_KEY=

# 크롤 킬스위치 (기본 꺼짐). 자세한 규칙은 README "수집 가드레일".
ENABLE_NAVER_AUX=false
NAVER_AUX_LEVEL=1
ENABLE_UMPPA_SNAPSHOT=false
# 서울형 키즈카페 정보 크롤 (umppa.seoul.go.kr/icare, robots Allow). 사용자 승인 후 켠다.
ENABLE_UMPPA=false

# 카카오맵 JS 키 (developers.kakao.com → 앱 키 → JavaScript 키; 플랫폼 Web 도메인 등록 + 제품 설정 카카오맵 ON 필요). 없으면 VWorld 래스터로 대체
NEXT_PUBLIC_KAKAO_JS_KEY=

# LLM 추출 백엔드: job-crawler와 같은 Azure AI Foundry 리소스 (v1 surface, model=배포명). 없으면 claude -p 헤드리스 사용
LLM_BACKEND=azure
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_RESOURCE=
AZURE_OPENAI_DEPLOYMENT=modulabs-gpt-5.5

# 카카오 로그인(Auth.js): apps/web/.env.local 에 AUTH_SECRET(openssl rand -base64 32), AUTH_KAKAO_ID(REST API 키), AUTH_KAKAO_SECRET(Client Secret)
